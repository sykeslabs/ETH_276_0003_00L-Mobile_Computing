#version 450
// Each 16 x 16 workgroup computes a tile and reuses operands in shared memory.
layout(local_size_x=16, local_size_y=16) in;
layout(set=0, binding=0, std430) readonly buffer InputA { float a[]; };
layout(set=0, binding=1, std430) readonly buffer InputB { float b[]; };
layout(set=0, binding=2, std430) writeonly buffer OutputC { float c[]; };
layout(push_constant) uniform Shape { uint n; } shape;
shared float tileA[16][16];
shared float tileB[16][16];
void main() {
    uint x=gl_LocalInvocationID.x, y=gl_LocalInvocationID.y;
    uint row=gl_GlobalInvocationID.y, col=gl_GlobalInvocationID.x;
    float sum=0.0;
    for (uint base=0; base<shape.n; base+=16) {
        tileA[y][x]=(row<shape.n && base+x<shape.n) ? a[row*shape.n+base+x] : 0.0;
        tileB[y][x]=(base+y<shape.n && col<shape.n) ? b[(base+y)*shape.n+col] : 0.0;
        barrier();
        for (uint k=0; k<16; ++k) sum += tileA[y][k]*tileB[k][x];
        barrier();
    }
    if (row<shape.n && col<shape.n) c[row*shape.n+col]=sum;
}
